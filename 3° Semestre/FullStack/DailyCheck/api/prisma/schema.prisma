generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model tarefa {
  id          Int      @id @default(autoincrement())
  titulo      String
  descricao   String
  imagemurl   String?
  datainicio  DateTime
  datafinal   DateTime
}